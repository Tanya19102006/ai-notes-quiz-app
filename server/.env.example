PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_notes_quiz
JWT_SECRET=replace_with_a_long_random_secret
# Free key from https://aistudio.google.com  (leave empty = demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional backup model, used when the main one is overloaded (leave empty to skip)
GEMINI_FALLBACK_MODEL=
# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
